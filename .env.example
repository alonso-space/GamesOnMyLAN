# IP de tu máquina en la red local
HOST_IP=192.168.1.50

# Base de datos. Elegir antes del primer arranque
DB_HOST=localhost
DB_PORT=5432
DB_USER=goml
DB_PASSWORD=cambia_esta_clave
DB_DATABASE=goml_db

# Puertos de GOML y de los juegos
APP_PORT=3000
GAMES_PORT=3001

# Permitir que cualquiera cree una cuenta (true / false)
GUEST_REGISTER=true

# Propietario inicial (solo se usa si la base no tiene usuarios)
OWNER_USER=owner
OWNER_PASSWORD=

# Limitación de usuarios
LIMIT_USERS=false
MAX_USERS=100

# Límites de subida por usuario (con LIMIT_GAMES=true). MAX_MBS está en megabytes.
# No aplican a los usuarios de confianza ni al owner
LIMIT_GAMES=false
GAMES_QTY=10
MAX_MBS=10240

# Clave de sesión personalizada (opcional)
# SESSION_SECRET=

# Modo público (internet, detrás de un proxy con HTTPS)
# PUBLIC_MODE=true
# GAMES_ORIGIN=https://games.tudominio.cl